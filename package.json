{
  "name": "commerce-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A readable, production-oriented commerce management foundation.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run lint && npm run test && npm run build",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:check": "npm run db:check --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
