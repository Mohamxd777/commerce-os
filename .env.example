# Copy this file to .env and replace placeholder values locally.
# Never commit .env or real credentials.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://commerce_os:change_me@localhost:5432/commerce_os
DATABASE_SSL=false
COOKIE_NAME=commerce_os_session
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12
# Managed image binaries live here; keep this outside the repository.
LOCAL_DATA_DIR=C:\Users\your-name\AppData\Local\CommerceOS
IMAGE_UPLOAD_MAX_BYTES=8388608
REMOTE_IMAGE_MAX_BYTES=10485760
NOON_ANALYZER_MAX_BYTES=2097152
NOON_ANALYZER_TIMEOUT_MS=12000
NOON_ANALYZER_MAX_REDIRECTS=3
NOON_ANALYZER_USER_AGENT=CommerceOS/1.0 research-link-analyzer (+local user-initiated request)
